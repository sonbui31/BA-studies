<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_cap_nhat_trang_thai" targetNamespace="http://bpmn.io/schema/bpmn" exporter="BA-agent bpmn_tool.py" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_cap_nhat_trang_thai">
    <bpmn:participant id="Participant_cap_nhat_trang_thai" name="SignalDesk" processRef="Process_cap_nhat_trang_thai" />
  </bpmn:collaboration>
  <bpmn:process id="Process_cap_nhat_trang_thai" name="Cập nhật trạng thái công khai và thông báo" isExecutable="false">
    <bpmn:laneSet id="LaneSet_cap_nhat_trang_thai">
      <bpmn:lane id="pm" name="Product Manager">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="he_thong" name="Hệ thống SignalDesk">
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_skip</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_sent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_failed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Mục feedback có tiến triển">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="t1" name="Đổi trạng thái công khai">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t2" name="Kiểm tra trạng thái thuộc danh sách công khai">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t3" name="Lưu lịch sử, xếp hàng gửi thông báo">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g1" name="Người theo dõi còn đăng ký?">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="end_skip" name="Không gửi">
      <bpmn:incoming>Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="t4" name="Gửi email thông báo">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g2" name="Kết quả gửi?">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="end_sent" name="Đã thông báo">
      <bpmn:incoming>Flow_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="end_failed" name="Chuyển hàng lỗi, cảnh báo nội bộ">
      <bpmn:incoming>Flow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="start" targetRef="t1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="t2" targetRef="t3" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="t3" targetRef="g1" />
    <bpmn:sequenceFlow id="Flow_5" name="Đã hủy đăng ký" sourceRef="g1" targetRef="end_skip" />
    <bpmn:sequenceFlow id="Flow_6" name="Còn" sourceRef="g1" targetRef="t4" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="t4" targetRef="g2" />
    <bpmn:sequenceFlow id="Flow_8" name="Thành công" sourceRef="g2" targetRef="end_sent" />
    <bpmn:sequenceFlow id="Flow_9" name="Lỗi, thử lại" sourceRef="g2" targetRef="t4" />
    <bpmn:sequenceFlow id="Flow_10" name="Lỗi sau 2 lần thử" sourceRef="g2" targetRef="end_failed" />
  </bpmn:process>
