    <bpmn:sequenceFlow id="Flow_18" sourceRef="w1" targetRef="m1" />
    <bpmn:sequenceFlow id="Flow_19" name="Rồi" sourceRef="g3" targetRef="t10" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="t10" targetRef="end" />
  </bpmn:process>
