<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_feedback_tobe" targetNamespace="http://bpmn.io/schema/bpmn" exporter="BA-agent bpmn_tool.py" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_feedback_tobe">
    <bpmn:participant id="Participant_feedback_tobe" name="SignalDesk" processRef="Process_feedback_tobe" />
  </bpmn:collaboration>
  <bpmn:process id="Process_feedback_tobe" name="To-Be: Vòng phản hồi feedback trên SignalDesk" isExecutable="false">
    <bpmn:laneSet id="LaneSet_feedback_tobe">
      <bpmn:lane id="khach_hang" name="Khách hàng">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="he_thong" name="Hệ thống SignalDesk">
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="pm" name="Product Manager">
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Có ý kiến về sản phẩm">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="t1" name="Gửi feedback trên portal">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t2" name="Đưa vào inbox của workspace">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t3" name="Xem feedback, gắn tag và trạng thái">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g1" name="Trùng feedback cũ?">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t4" name="Gộp phiếu bầu và lịch sử (BR-002)">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="m1" name="">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t5" name="Báo trạng thái cho người theo dõi">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t6" name="Phát hành release note gắn feedback (BR-004)">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="end" name="Khách thấy feedback đã được làm">
      <bpmn:incoming>Flow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="start" targetRef="t1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="t2" targetRef="t3" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="t3" targetRef="g1" />
    <bpmn:sequenceFlow id="Flow_5" name="Có" sourceRef="g1" targetRef="t4" />
    <bpmn:sequenceFlow id="Flow_6" name="Không" sourceRef="g1" targetRef="m1" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="t4" targetRef="m1" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="m1" targetRef="t5" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="t5" targetRef="t6" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="t6" targetRef="end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_feedback_tobe">
    <bpmndi:BPMNPlane id="BPMNPlane_feedback_tobe" bpmnElement="Collaboration_feedback_tobe">
      <bpmndi:BPMNShape id="Participant_feedback_tobe_di" bpmnElement="Participant_feedback_tobe" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1690" height="730" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="khach_hang_di" bpmnElement="khach_hang" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="1660" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="he_thong_di" bpmnElement="he_thong" isHorizontal="true">
        <dc:Bounds x="190" y="280" width="1660" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pm_di" bpmnElement="pm" isHorizontal="true">
        <dc:Bounds x="190" y="480" width="1660" height="330" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="287" y="162" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="250" y="202" width="110" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t1_di" bpmnElement="t1">
        <dc:Bounds x="390" y="140" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t2_di" bpmnElement="t2">
        <dc:Bounds x="580" y="340" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t3_di" bpmnElement="t3">
        <dc:Bounds x="770" y="540" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g1_di" bpmnElement="g1" isMarkerVisible="true">
        <dc:Bounds x="960" y="555" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="930" y="511" width="110" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t4_di" bpmnElement="t4">
        <dc:Bounds x="1070" y="670" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="m1_di" bpmnElement="m1" isMarkerVisible="true">
        <dc:Bounds x="1260" y="555" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t5_di" bpmnElement="t5">
        <dc:Bounds x="1370" y="340" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t6_di" bpmnElement="t6">
        <dc:Bounds x="1560" y="540" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end">
        <dc:Bounds x="1757" y="162" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1720" y="202" width="110" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="323" y="180" />
        <di:waypoint x="390" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="520" y="180" />
        <di:waypoint x="535" y="180" />
        <di:waypoint x="535" y="380" />
        <di:waypoint x="580" y="380" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="710" y="380" />
        <di:waypoint x="725" y="380" />
        <di:waypoint x="725" y="580" />
        <di:waypoint x="770" y="580" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="900" y="580" />
        <di:waypoint x="960" y="580" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="985" y="605" />
        <di:waypoint x="985" y="710" />
        <di:waypoint x="1070" y="710" />
        <bpmndi:BPMNLabel><dc:Bounds x="991" y="609" width="24" height="18" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="1010" y="580" />
        <di:waypoint x="1260" y="580" />
        <bpmndi:BPMNLabel><dc:Bounds x="1014" y="560" width="44" height="18" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="1200" y="710" />
        <di:waypoint x="1285" y="710" />
        <di:waypoint x="1285" y="605" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8">
        <di:waypoint x="1285" y="555" />
        <di:waypoint x="1285" y="380" />
        <di:waypoint x="1370" y="380" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9">
        <di:waypoint x="1500" y="380" />
        <di:waypoint x="1515" y="380" />
        <di:waypoint x="1515" y="580" />
        <di:waypoint x="1560" y="580" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10">
        <di:waypoint x="1690" y="580" />
        <di:waypoint x="1705" y="580" />
        <di:waypoint x="1705" y="180" />
        <di:waypoint x="1757" y="180" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
