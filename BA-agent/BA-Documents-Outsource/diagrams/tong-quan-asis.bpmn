<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_tong_quan_asis" targetNamespace="http://bpmn.io/schema/bpmn" exporter="BA-agent bpmn_tool.py" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_tong_quan_asis">
    <bpmn:participant id="Participant_tong_quan_asis" name="Bệnh viện Đa khoa An Phúc" processRef="Process_tong_quan_asis" />
  </bpmn:collaboration>
  <bpmn:process id="Process_tong_quan_asis" name="Tổng quan As-Is: Vòng đời tài sản" isExecutable="false">
    <bpmn:laneSet id="LaneSet_tong_quan_asis">
      <bpmn:lane id="khoa" name="Khoa sử dụng">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="vat_tu" name="Phòng Vật tư">
        <bpmn:flowNodeRef>a2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="ky_su" name="Kỹ sư thiết bị y tế">
        <bpmn:flowNodeRef>a5</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Có tài sản mới">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="a1" name="Báo tài sản mới qua email hoặc phiếu">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="a2" name="Ghi vào file Excel tổng, tên tự đặt, không có mã chung (PD-01)">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="a3" name="Sử dụng tài sản tại khoa">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:inclusiveGateway id="g1" name="Phát sinh việc gì trong tháng?">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:task id="a4" name="Điều chuyển ghi tay hoặc qua email (PD-02)">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="a5" name="Nhắc và làm bảo trì theo email, sổ riêng (PD-03)">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="a6" name="Kiểm kê bằng tay cuối tháng">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:inclusiveGateway id="g2" name="">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:task id="a7" name="Gộp file các khoa, làm báo cáo Excel (PD-04)">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="end" name="Báo cáo điều hành chậm 5-7 ngày">
      <bpmn:incoming>Flow_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="start" targetRef="a1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="a1" targetRef="a2" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="a2" targetRef="a3" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="a3" targetRef="g1" />
    <bpmn:sequenceFlow id="Flow_5" name="Khoa cần chuyển tài sản" sourceRef="g1" targetRef="a4" />
    <bpmn:sequenceFlow id="Flow_6" name="Thiết bị đến hạn bảo trì" sourceRef="g1" targetRef="a5" />
    <bpmn:sequenceFlow id="Flow_7" name="Cuối tháng" sourceRef="g1" targetRef="a6" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="a4" targetRef="g2" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="a5" targetRef="g2" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="a6" targetRef="g2" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="g2" targetRef="a7" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="a7" targetRef="end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_tong_quan_asis">
    <bpmndi:BPMNPlane id="BPMNPlane_tong_quan_asis" bpmnElement="Collaboration_tong_quan_asis">
      <bpmndi:BPMNShape id="Participant_tong_quan_asis_di" bpmnElement="Participant_tong_quan_asis" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1572" height="600" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="khoa_di" bpmnElement="khoa" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="1542" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="vat_tu_di" bpmnElement="vat_tu" isHorizontal="true">
        <dc:Bounds x="190" y="280" width="1542" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ky_su_di" bpmnElement="ky_su" isHorizontal="true">
        <dc:Bounds x="190" y="480" width="1542" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="287" y="162" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="250" y="202" width="110" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="a1_di" bpmnElement="a1">
        <dc:Bounds x="390" y="140" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="a2_di" bpmnElement="a2" bioc:stroke="#C53030" bioc:fill="#FFF5F5" color:border-color="#C53030" color:background-color="#FFF5F5">
        <dc:Bounds x="580" y="340" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="a3_di" bpmnElement="a3">
        <dc:Bounds x="770" y="140" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g1_di" bpmnElement="g1">
        <dc:Bounds x="996" y="355" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="890" y="313" width="110" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="a4_di" bpmnElement="a4" bioc:stroke="#C53030" bioc:fill="#FFF5F5" color:border-color="#C53030" color:background-color="#FFF5F5">
        <dc:Bounds x="1142" y="140" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="a5_di" bpmnElement="a5" bioc:stroke="#C53030" bioc:fill="#FFF5F5" color:border-color="#C53030" color:background-color="#FFF5F5">
        <dc:Bounds x="1142" y="540" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="a6_di" bpmnElement="a6">
        <dc:Bounds x="1142" y="340" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g2_di" bpmnElement="g2">
        <dc:Bounds x="1332" y="355" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="a7_di" bpmnElement="a7" bioc:stroke="#C53030" bioc:fill="#FFF5F5" color:border-color="#C53030" color:background-color="#FFF5F5">
        <dc:Bounds x="1442" y="340" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end">
        <dc:Bounds x="1639" y="362" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1602" y="402" width="110" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="323" y="180" />
        <di:waypoint x="390" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="520" y="180" />
        <di:waypoint x="535" y="180" />
        <di:waypoint x="535" y="380" />
        <di:waypoint x="580" y="380" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
