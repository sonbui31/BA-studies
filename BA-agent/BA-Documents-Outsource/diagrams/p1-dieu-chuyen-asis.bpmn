<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_p1_dieu_chuyen_asis" targetNamespace="http://bpmn.io/schema/bpmn" exporter="BA-agent bpmn_tool.py" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_p1_dieu_chuyen_asis">
    <bpmn:participant id="Participant_p1_dieu_chuyen_asis" name="Bệnh viện Đa khoa An Phúc" processRef="Process_p1_dieu_chuyen_asis" />
  </bpmn:collaboration>
  <bpmn:process id="Process_p1_dieu_chuyen_asis" name="P1 As-Is: Điều chuyển tài sản giữa các khoa" isExecutable="false">
    <bpmn:laneSet id="LaneSet_p1_dieu_chuyen_asis">
      <bpmn:lane id="khoa_giao" name="Khoa giao">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="vat_tu" name="Phòng Vật tư">
        <bpmn:flowNodeRef>a2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="khoa_nhan" name="Khoa nhận">
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_signed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_unknown</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Cần chuyển tài sản sang khoa khác">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="a1" name="Gửi email hoặc phiếu giấy cho Phòng Vật tư">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="a2" name="Sửa file Excel tổng (PD-02)">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="a3" name="Mang tài sản sang khoa nhận">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g1" name="Khoa nhận ký sổ bàn giao?">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="end_signed" name="Tài sản ở khoa mới, có chữ ký giấy">
      <bpmn:incoming>Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="end_unknown" name="Không rõ ai đang giữ tài sản (PD-02)">
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="start" targetRef="a1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="a1" targetRef="a2" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="a2" targetRef="a3" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="a3" targetRef="g1" />
    <bpmn:sequenceFlow id="Flow_5" name="Có" sourceRef="g1" targetRef="end_signed" />
    <bpmn:sequenceFlow id="Flow_6" name="Không" sourceRef="g1" targetRef="end_unknown" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_p1_dieu_chuyen_asis">
    <bpmndi:BPMNPlane id="BPMNPlane_p1_dieu_chuyen_asis" bpmnElement="Collaboration_p1_dieu_chuyen_asis">
      <bpmndi:BPMNShape id="Participant_p1_dieu_chuyen_asis_di" bpmnElement="Participant_p1_dieu_chuyen_asis" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1010" height="730" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="khoa_giao_di" bpmnElement="khoa_giao" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="980" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="vat_tu_di" bpmnElement="vat_tu" isHorizontal="true">
        <dc:Bounds x="190" y="280" width="980" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="khoa_nhan_di" bpmnElement="khoa_nhan" isHorizontal="true">
        <dc:Bounds x="190" y="480" width="980" height="330" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
