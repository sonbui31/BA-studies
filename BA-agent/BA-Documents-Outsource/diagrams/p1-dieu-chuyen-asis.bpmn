        <bpmndi:BPMNLabel>
          <dc:Bounds x="250" y="202" width="110" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="a1_di" bpmnElement="a1">
        <dc:Bounds x="390" y="140" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="a2_di" bpmnElement="a2" bioc:stroke="#C53030" bioc:fill="#FFF5F5" color:border-color="#C53030" color:background-color="#FFF5F5">
        <dc:Bounds x="580" y="340" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="a3_di" bpmnElement="a3">
        <dc:Bounds x="770" y="140" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g1_di" bpmnElement="g1" isMarkerVisible="true">
        <dc:Bounds x="960" y="555" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="854" y="513" width="110" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_signed_di" bpmnElement="end_signed">
        <dc:Bounds x="1077" y="562" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1040" y="602" width="110" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_unknown_di" bpmnElement="end_unknown" bioc:stroke="#C53030" bioc:fill="#FFF5F5" color:border-color="#C53030" color:background-color="#FFF5F5">
        <dc:Bounds x="1077" y="692" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1040" y="732" width="110" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="323" y="180" />
        <di:waypoint x="390" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="520" y="180" />
        <di:waypoint x="535" y="180" />
        <di:waypoint x="535" y="380" />
        <di:waypoint x="580" y="380" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="710" y="380" />
        <di:waypoint x="725" y="380" />
        <di:waypoint x="725" y="180" />
        <di:waypoint x="770" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="900" y="180" />
        <di:waypoint x="985" y="180" />
