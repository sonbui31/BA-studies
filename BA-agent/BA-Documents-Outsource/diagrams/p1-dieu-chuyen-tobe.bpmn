  <bpmn:process id="Process_p1_dieu_chuyen_tobe" name="P1 To-Be: Điều chuyển tài sản giữa các khoa" isExecutable="false">
    <bpmn:laneSet id="LaneSet_p1_dieu_chuyen_tobe">
      <bpmn:lane id="khoa_giao" name="Khoa giao">
