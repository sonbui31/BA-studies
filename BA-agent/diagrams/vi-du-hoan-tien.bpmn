<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_vi_du_hoan_tien" targetNamespace="http://bpmn.io/schema/bpmn" exporter="BA-agent bpmn_tool.py" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_vi_du_hoan_tien">
    <bpmn:participant id="Participant_vi_du_hoan_tien" name="Cửa hàng trực tuyến" processRef="Process_vi_du_hoan_tien" />
  </bpmn:collaboration>
  <bpmn:process id="Process_vi_du_hoan_tien" name="Ví dụ: Duyệt hoàn tiền đơn hàng" isExecutable="false">
    <bpmn:laneSet id="LaneSet_vi_du_hoan_tien">
      <bpmn:lane id="cskh" name="Chăm sóc khách hàng">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="quan_ly" name="Quản lý">
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>timer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_remind</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_remind</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="he_thong" name="Hệ thống bán hàng">
        <bpmn:flowNodeRef>t_reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Nhận yêu cầu hoàn tiền">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="start_def" />
    </bpmn:startEvent>
    <bpmn:task id="t1" name="Kiểm tra yêu cầu và đơn hàng">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g1" name="Giá trị đơn trên 1 triệu?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t2" name="Duyệt hoàn tiền">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:boundaryEvent id="timer" name="Quá 24 giờ" attachedToRef="t2" cancelActivity="false">
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:timerEventDefinition id="timer_def" />
    </bpmn:boundaryEvent>
    <bpmn:task id="t_remind" name="Nhắc Quản lý duyệt">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="end_remind" name="Đã nhắc">
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="g2" name="Đồng ý?">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t_reject" name="Gửi thư từ chối kèm lý do">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="end_rejected" name="Yêu cầu bị từ chối">
      <bpmn:incoming>Flow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="m1" name="">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="p1" name="">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="t3" name="Hoàn tiền về tài khoản khách">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t4" name="Gửi thư xác nhận hoàn tiền">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="p2" name="">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="end_done" name="Khách đã được hoàn tiền">
      <bpmn:incoming>Flow_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="start" targetRef="t1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="t1" targetRef="g1" />
    <bpmn:sequenceFlow id="Flow_3" name="Có" sourceRef="g1" targetRef="t2" />
    <bpmn:sequenceFlow id="Flow_4" name="Không" sourceRef="g1" targetRef="m1" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="timer" targetRef="t_remind" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="t_remind" targetRef="end_remind" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="t2" targetRef="g2" />
    <bpmn:sequenceFlow id="Flow_8" name="Từ chối" sourceRef="g2" targetRef="t_reject" />
    <bpmn:sequenceFlow id="Flow_9" name="Đồng ý" sourceRef="g2" targetRef="m1" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="t_reject" targetRef="end_rejected" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="m1" targetRef="p1" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="p1" targetRef="t3" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="p1" targetRef="t4" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="t3" targetRef="p2" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="t4" targetRef="p2" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="p2" targetRef="end_done" />
  </bpmn:process>
